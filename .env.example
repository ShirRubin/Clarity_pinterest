# Copy to .env and fill in. Never commit .env.

# Notion internal integration token (starts with "ntn_" or "secret_")
# Create at https://www.notion.so/my-integrations → New integration → copy token.
NOTION_TOKEN=

# The Notion page under which the "Clarity Pins" database will be created.
# Open the page in Notion → Share → Copy link → the 32-char id from the URL.
# After creating the integration, connect it to this page:
# page menu (⋯) → Connections → your integration.
NOTION_PARENT_PAGE_ID=

# Filled automatically by scripts/setup-notion.ts after it creates the database.
NOTION_DB_ID=

# NO Anthropic API key needed. The idea/draft stages shell out to the Claude Code
# CLI (`claude -p`), which authenticates with the user's Claude Max subscription.
# Requirement: Claude Code installed and logged in (`claude` on PATH).
# Optional overrides:
#   CLARITY_MODEL       model alias or id for generation (default: opus)
#   CLAUDE_CLI          path to the claude binary if it isn't on PATH
#   CLARITY_TIMEOUT_MS  per-call timeout in ms (default: 300000)

# Pinterest API (Phase 4 — leave empty until the developer app exists)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
